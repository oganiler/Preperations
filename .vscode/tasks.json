{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "drill: build + test (ASan/UBSan) - current day",
      "detail": "run_drill.sh on the day directory of the file you have open",
      "type": "shell",
      "command": "./scripts/run_drill.sh",
      "args": [
        "${fileDirname}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "drill: release timing - current day",
      "detail": "-O2 -DNDEBUG, no sanitizers. The number you record in notes.md",
      "type": "shell",
      "command": "./scripts/run_drill.sh",
      "args": [
        "${fileDirname}",
        "--release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": "build"
    },
    {
      "label": "cmake: configure",
      "detail": "Re-run after new_day.sh so the new day gets a target and IntelliSense",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build",
        "-G",
        "Ninja"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "type": "cppbuild",
      "label": "C/C++: g++ build active file",
      "detail": "Hijacked: builds solution.cpp + tests.cpp of the current day, with -Icommon",
      "command": "/usr/bin/g++",
      "args": [
        "-fdiagnostics-color=always",
        "-std=c++20",
        "-g",
        "-O1",
        "-fsanitize=address,undefined",
        "-fno-omit-frame-pointer",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-Wshadow",
        "-Wconversion",
        "-Wsign-conversion",
        "-I${workspaceFolder}/common",
        "-I${fileDirname}",
        "${fileDirname}/solution.cpp",
        "${fileDirname}/tests.cpp",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
