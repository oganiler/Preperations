{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug current drill (CMake target)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "environment": [
        { "name": "ASAN_OPTIONS", "value": "abort_on_error=1:detect_leaks=1" },
        { "name": "UBSAN_OPTIONS", "value": "print_stacktrace=1" }
      ],
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        { "description": "pretty-print std:: containers",
          "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}
